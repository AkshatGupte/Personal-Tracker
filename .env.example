# Copy this file to `.env` before the first run:
#
#     cp .env.example .env
#
# Rendred is a local-first app: one SQLite file on your own machine, no auth, no
# hosting, nothing to sign up for. This is the only variable it needs.
#
# The path is relative to the project root. `prisma7.config.ts` loads this file
# for the Prisma CLI, and Next.js loads it for the app.
DATABASE_URL="file:./prisma/dev.db"

# Optional. Only needed for the Phase 3 LLM features (suggested curricula and
# insight remarks), which are not built yet — leave it unset until they are.
# ANTHROPIC_API_KEY=
