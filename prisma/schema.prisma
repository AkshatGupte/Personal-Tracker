// Schema for Rendred. Ground truth is docs/SCHEMA.md — keep the two in sync.
// Phase 1 covers Track, Topic, Task and CompletionLog. InsightLog (Phase 3)
// and UserPreferences (Phase 4) are deliberately not modelled yet.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A top-level learning goal, e.g. "DSA" or "Spanish".
model Track {
  id   String @id @default(cuid())
  name String

  // Strict streak: a missed day resets currentStreak to 0. No forgiveness.
  currentStreak Int @default(0)
  longestStreak Int @default(0)

  // Null until the first task is completed on this track.
  lastActivityDate DateTime?

  createdAt DateTime @default(now())

  topics         Topic[]
  completionLogs CompletionLog[]
}

/// A sub-category within a Track, e.g. "Arrays" or "Graphs".
model Topic {
  id      String @id @default(cuid())
  trackId String
  name    String

  /// True if this came from the suggested curriculum, false if user-added.
  isExpected Boolean @default(false)

  /// Explicit order within the track. A curriculum is a sequence, and creation
  /// order does not survive reordering or regeneration, so ordering is stored
  /// rather than inferred from createdAt.
  position Int @default(0)

  createdAt DateTime @default(now())

  track Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([trackId])
  @@index([trackId, position])
}

/// A persistent recurring learning activity within a Topic, e.g. "Practice
/// array problems". A task is never permanently completed: it stays available
/// indefinitely and is checked in once per day. There is deliberately no
/// one-time task type and no `kind` discriminator — see docs/PRD.md.
model Task {
  id      String @id @default(cuid())
  topicId String
  title   String

  /// Optional: "easy" | "medium" | "hard".
  difficulty String?

  /// Explicit order within the topic. Same reasoning as Topic.position.
  position Int @default(0)

  createdAt DateTime @default(now())

  topic    Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  checkIns TaskCheckIn[]

  @@index([topicId])
  @@index([topicId, position])
}

/// One row per task per day: the user's statement that they did this activity
/// today. This is the ground truth the whole product is built on — CompletionLog
/// is a derived per-track rollup of these rows and can always be rebuilt.
///
/// There is no status column. The row's existence *is* the state, so undoing a
/// check-in deletes the row rather than flipping a flag.
model TaskCheckIn {
  id     String   @id @default(cuid())
  taskId String

  /// Local midnight, normalised through startOfDay() in lib/day.ts — the same
  /// convention as CompletionLog.date.
  date DateTime

  /// The real time of day. Kept for interest; nothing reads it for logic.
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// One check-in per task per day. Enforced here rather than in application
  /// code, so a double submit cannot produce two rows for one day.
  @@unique([taskId, date])
  @@index([taskId])
  @@index([date])
}

/// One row per track per day, so streaks and weekly/monthly rollups can be
/// read directly instead of recounting every task each time.
model CompletionLog {
  id      String   @id @default(cuid())
  trackId String
  date    DateTime

  tasksCompletedCount Int @default(0)

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// Enforces the "one entry per track per day" rule from docs/SCHEMA.md.
  @@unique([trackId, date])
  @@index([trackId])
}
