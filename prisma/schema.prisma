// Schema for Rendred. Ground truth is docs/SCHEMA.md — keep the two in sync.
//
// A Track holds a recursive tree of Topics, at most 5 levels deep. A Topic with
// children is a parent and is not actionable; a Topic with no children is a
// leaf and is the unit of activity. There is deliberately no Task model: a leaf
// Topic *is* the task, which is what lets the same structure describe a chess
// opening repertoire and a Spanish curriculum without either being special.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A top-level learning goal, e.g. "DSA" or "Spanish".
///
/// Carries no cached streak columns. A strict streak breaks through
/// *inactivity*, and inactivity by definition writes nothing — so a cached
/// number has no code path that could expire it, and would read as alive days
/// after it lapsed. Streaks, coverage and totals are all derived from
/// TopicActivity on read; for a single local user the whole history is a few
/// hundred rows.
model Track {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())

  topics Topic[]
}

/// A node in a Track's topic tree.
///
/// The same model is both the branch and the leaf. Whether a node is actionable
/// is a question about its children, never a stored flag — so a leaf that gains
/// children stops being actionable the moment they exist, and becomes actionable
/// again if they are removed, with its own history still attached.
model Topic {
  id       String  @id @default(cuid())
  trackId  String
  /// Null for a top-level topic. Otherwise the node this one hangs under.
  parentId String?
  name     String

  /// Explicit order among siblings. Shared by the flat and tree views, so a
  /// reorder in one is a reorder in both. Creation order does not survive a
  /// move, which is why this is stored rather than inferred.
  position Int @default(0)

  /// 1 for a top-level topic, up to MAX_DEPTH (5). Denormalised so the depth
  /// rule can be enforced with a single read instead of walking to the root on
  /// every insert, and rewritten across a whole subtree when one is moved.
  depth Int @default(1)

  /// Soft delete. Deleted nodes leave current tree and coverage calculations
  /// immediately but keep their activity rows, so historical views still show
  /// what happened on the days they were alive.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  track    Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  parent   Topic?          @relation("TopicChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Topic[]         @relation("TopicChildren")
  activity TopicActivity[]

  @@index([trackId])
  @@index([parentId])
  @@index([trackId, parentId, position])
}

/// One row per topic per day, holding how many times that leaf was worked.
///
/// This is the single source of truth for every activity figure in the app —
/// intensity, coverage, streaks, history. Nothing rolls it up into a second
/// table: a per-track daily rollup existed under the old model and was pure
/// derived state that had to be rebuilt whenever anything moved or was deleted.
///
/// A count rather than a row per click: the product question is "how much did
/// this node get worked today", and undo has to decrement the same number the
/// tiers read. At zero the row is deleted, so presence means activity and no
/// zero row can be mistaken for a worked day.
model TopicActivity {
  id      String @id @default(cuid())
  topicId String

  /// Local midnight, normalised through startOfDay() in lib/day.ts.
  date DateTime

  /// Clicks recorded on this node on this day. Always >= 1 while the row
  /// exists. Stored uncapped even though intensity tiers top out at 5.
  count Int @default(1)

  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// One row per node per day. Enforced here rather than in application code,
  /// so a double submit cannot produce two rows for one day.
  @@unique([topicId, date])
  @@index([topicId])
  @@index([date])
}

/// A time-boxed target: "50 DSA problems by Sunday".
///
/// **Deliberately not a Track.** A Track is open-ended and never finishes — that
/// is the product's core claim, stated at the top of CLAUDE.md. A Goal is the
/// opposite shape: it has a target, a deadline and a terminal state. Modelling
/// one as the other would have forced a finish line onto the thing that must not
/// have one, so they are separate and a Goal carries its own progress rather
/// than reading TopicActivity.
///
/// **`expired` is not a stored status, and that is load-bearing.** Stored status
/// is only ever `active`, `completed` or `archived`; expiry is a question about
/// the deadline and today, answered on read in `lib/goals.ts`. A stored one
/// would need something to run at midnight to set it, and with no server process
/// and no cron in this project that something does not exist — so the column
/// would read "active" for a goal that expired a week ago, which is exactly the
/// class of bug the cached-streak columns were removed to avoid.
model Goal {
  id          String  @id @default(cuid())
  title       String
  description String?
  /// Free text, e.g. "DSA" or "Fitness". Not an enum: the categories are the
  /// user's own vocabulary and adding one must not need a migration.
  category    String

  /// What counts as done, in `unit`. Float so "30 hours" and "2.5 books" work.
  target Float
  unit   String

  /// The live figure. Denormalised from `entries` on purpose — every card reads
  /// it and rebuilding a sum per card per render is the one place derive-on-read
  /// would cost more than it is worth. `entries` remains the audit trail, and
  /// `lib/goals.ts` reconciles the two.
  currentProgress Float @default(0)

  /// The highest `currentProgress` has ever been. **This is the anti-farming
  /// mechanism.** Progress XP and milestones are awarded only when a write
  /// pushes past it, so 37 → 38 → 37 → 38 pays once. Stored rather than derived
  /// from `entries` because it must be read and compared inside the same
  /// transaction that writes the new value.
  highWater Float @default(0)

  startDate DateTime
  deadline  DateTime
  /// `weekly` | `monthly` | `custom`. Kept so a restarted goal can roll its own
  /// window forward without the user re-deriving the dates.
  cadence   String   @default("custom")

  /// `active` | `completed` | `archived`. See the note above on `expired`.
  status String @default("active")

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  milestones GoalMilestone[]
  entries    GoalProgress[]

  @@index([status])
  @@index([deadline])
}

/// A milestone that has actually been crossed. One row, once, ever.
///
/// **The `@@unique` is the whole "trigger only once" requirement**, enforced by
/// the database rather than by an application flag somebody has to remember to
/// check. A double submit, a decrease and re-cross, or two tabs racing all
/// collide on the constraint instead of paying out twice.
model GoalMilestone {
  id     String @id @default(cuid())
  goalId String

  /// 25, 50, 75 or 100.
  percent Int
  /// Banked at award time. Stored because the XP table could be retuned later
  /// and a ledger must not silently restate what it already paid.
  xp      Int

  reachedAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, percent])
  @@index([goalId])
}

/// One progress write. The audit trail, and the XP ledger.
///
/// Every change is a row, including decreases and the ones that paid no XP —
/// "progress history should allow future analytics", and a history that only
/// kept the rewarding half would be useless for that.
model GoalProgress {
  id     String @id @default(cuid())
  goalId String

  /// Signed. Negative for a correction downward.
  delta Float
  /// `currentProgress` after this write, so the series is readable without
  /// replaying every delta from zero.
  value Float
  /// What this write paid. 0 for a decrease or a re-cross of ground already
  /// covered — see `Goal.highWater`.
  xp    Int   @default(0)

  at DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([at])
}
