// Schema for Rendred. Ground truth is docs/SCHEMA.md — keep the two in sync.
//
// A Track holds a recursive tree of Topics, at most 5 levels deep. A Topic with
// children is a parent and is not actionable; a Topic with no children is a
// leaf and is the unit of activity. There is deliberately no Task model: a leaf
// Topic *is* the task, which is what lets the same structure describe a chess
// opening repertoire and a Spanish curriculum without either being special.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A top-level learning goal, e.g. "DSA" or "Spanish".
///
/// Carries no cached streak columns. A strict streak breaks through
/// *inactivity*, and inactivity by definition writes nothing — so a cached
/// number has no code path that could expire it, and would read as alive days
/// after it lapsed. Streaks, coverage and totals are all derived from
/// TopicActivity on read; for a single local user the whole history is a few
/// hundred rows.
model Track {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())

  topics Topic[]
}

/// A node in a Track's topic tree.
///
/// The same model is both the branch and the leaf. Whether a node is actionable
/// is a question about its children, never a stored flag — so a leaf that gains
/// children stops being actionable the moment they exist, and becomes actionable
/// again if they are removed, with its own history still attached.
model Topic {
  id       String  @id @default(cuid())
  trackId  String
  /// Null for a top-level topic. Otherwise the node this one hangs under.
  parentId String?
  name     String

  /// Explicit order among siblings. Shared by the flat and tree views, so a
  /// reorder in one is a reorder in both. Creation order does not survive a
  /// move, which is why this is stored rather than inferred.
  position Int @default(0)

  /// 1 for a top-level topic, up to MAX_DEPTH (5). Denormalised so the depth
  /// rule can be enforced with a single read instead of walking to the root on
  /// every insert, and rewritten across a whole subtree when one is moved.
  depth Int @default(1)

  /// Soft delete. Deleted nodes leave current tree and coverage calculations
  /// immediately but keep their activity rows, so historical views still show
  /// what happened on the days they were alive.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  track    Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  parent   Topic?          @relation("TopicChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Topic[]         @relation("TopicChildren")
  activity TopicActivity[]

  @@index([trackId])
  @@index([parentId])
  @@index([trackId, parentId, position])
}

/// One row per topic per day, holding how many times that leaf was worked.
///
/// This is the single source of truth for every activity figure in the app —
/// intensity, coverage, streaks, history. Nothing rolls it up into a second
/// table: a per-track daily rollup existed under the old model and was pure
/// derived state that had to be rebuilt whenever anything moved or was deleted.
///
/// A count rather than a row per click: the product question is "how much did
/// this node get worked today", and undo has to decrement the same number the
/// tiers read. At zero the row is deleted, so presence means activity and no
/// zero row can be mistaken for a worked day.
model TopicActivity {
  id      String @id @default(cuid())
  topicId String

  /// Local midnight, normalised through startOfDay() in lib/day.ts.
  date DateTime

  /// Clicks recorded on this node on this day. Always >= 1 while the row
  /// exists. Stored uncapped even though intensity tiers top out at 5.
  count Int @default(1)

  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// One row per node per day. Enforced here rather than in application code,
  /// so a double submit cannot produce two rows for one day.
  @@unique([topicId, date])
  @@index([topicId])
  @@index([date])
}
